# ==============================================================================
# FSAE Order Manager — Configuration d'Environnement (.env)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' pour personnaliser votre environnement.
# Ce fichier est ignoré par Git et reste strictement local à votre machine.

# Port d'écoute HTTP interne
PORT=3000

# ------------------------------------------------------------------------------
# 1. Choix du mode d'environnement et de la Base de Données
# ------------------------------------------------------------------------------
# SUR VOTRE POSTE LOCAL (Développement & Tests) :
# NODE_ENV=development
# DB_PATH=/app/data/fsae_orders_dev.db
#
# SUR VOTRE RASPBERRY PI (Production officielle Écurie UQTR) :
NODE_ENV=production
DB_PATH=/app/data/fsae_orders.db

# ------------------------------------------------------------------------------
# 2. Sécurité & Authentification JWT
# ------------------------------------------------------------------------------
JWT_SECRET=fsae-raspberry-pi-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Webhook Discord (Optionnel)
# ------------------------------------------------------------------------------
# Collez ici l'URL de votre Webhook Discord pour recevoir les alertes de commandes
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. Cloudflare Tunnel (Optionnel — Pour accès distant sécurisé)
# ------------------------------------------------------------------------------
# Si vous utilisez un tunnel Cloudflare Zero Trust, collez ici le token du tunnel
# Ensuite, lancez : docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

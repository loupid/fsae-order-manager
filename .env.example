# ===================================================
# FSAE Order Manager — Configuration Environnement
# ===================================================

PORT=3000
NODE_ENV=production

# Clé secrète pour les tokens de session JWT (Changez cette valeur en production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-for-your-fsae-team
JWT_EXPIRES_IN=7d

# Chemin de la base SQLite (utilisé par Docker)
DB_PATH=/app/data/fsae_orders.db

# URL du Webhook Discord pour les notifications automatiques
DISCORD_WEBHOOK_URL=

# Compte administrateur initial (généré au premier démarrage)
ADMIN_NAME=FSAE Lead Admin
ADMIN_EMAIL=admin@fsae.org
ADMIN_PASSWORD=admin123
